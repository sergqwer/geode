// Peak FP16 throughput: 8 independent FMA chains of f16vec4 per invocation.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Out { vec4 o[]; };
layout(push_constant) uniform P { uint iters; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    f16vec4 b = f16vec4(0.999), a = f16vec4(0.0001);
    f16vec4 c0 = f16vec4(float16_t(float(i & 255u) * 1e-3)), c1 = c0 + float16_t(0.1), c2 = c0 + float16_t(0.2);
    f16vec4 c3 = c0 + float16_t(0.3), c4 = c0 + float16_t(0.4), c5 = c0 + float16_t(0.5), c6 = c0 + float16_t(0.6);
    f16vec4 c7 = c0 + float16_t(0.7);
    for (uint n = 0u; n < p.iters; ++n) {
        c0 = fma(c0, b, a); c1 = fma(c1, b, a); c2 = fma(c2, b, a); c3 = fma(c3, b, a);
        c4 = fma(c4, b, a); c5 = fma(c5, b, a); c6 = fma(c6, b, a); c7 = fma(c7, b, a);
    }
    o[i] = vec4(c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7);
}
