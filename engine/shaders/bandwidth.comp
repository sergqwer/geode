// Memory read bandwidth: every invocation sums a strided share of a large buffer.
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { vec4 v[]; };
layout(std430, binding = 1) writeonly buffer Out { vec4 o[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint total = gl_NumWorkGroups.x * 256u;
    vec4 s = vec4(0.0);
    for (uint k = i; k < p.n; k += total) s += v[k];
    o[i] = s;
}
