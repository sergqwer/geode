// Peak INT32 multiply-add throughput: 8 independent chains of ivec4 per invocation.
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Out { ivec4 o[]; };
layout(push_constant) uniform P { uint iters; } p;
void main() {
    int i = int(gl_GlobalInvocationID.x);
    ivec4 b = ivec4(3), a = ivec4(7);
    ivec4 c0 = ivec4(i), c1 = c0 + 1, c2 = c0 + 2, c3 = c0 + 3, c4 = c0 + 4, c5 = c0 + 5, c6 = c0 + 6, c7 = c0 + 7;
    for (uint n = 0u; n < p.iters; ++n) {
        c0 = c0 * b + a; c1 = c1 * b + a; c2 = c2 * b + a; c3 = c3 * b + a;
        c4 = c4 * b + a; c5 = c5 * b + a; c6 = c6 * b + a; c7 = c7 * b + a;
    }
    o[gl_GlobalInvocationID.x] = c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7;
}
