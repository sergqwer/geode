<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted connections everywhere, but to the phone itself: a model served on the phone (an outside service's
     kind of server run in Termux, say) is reached at http://127.0.0.1 - that traffic never leaves the phone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
