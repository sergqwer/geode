<?xml version="1.0" encoding="utf-8"?>
<!-- What other apps may be handed: the agents' folders and the songs (a share, an "open with"), and the cache's
     camera/ the phone's camera app writes a photo or a video into for the chat (ChatScreen) -->
<paths>
    <files-path name="agents" path="agents/" />
    <cache-path name="camera" path="camera/" />
    <!-- the songs (a share, an "open with") -->
    <files-path name="songs" path="music/songs/" />
    <!-- a song shared under its title (MusicViewModel.shareIntent: a hard link into cache/shared/) -->
    <cache-path name="shared" path="shared/" />
</paths>
