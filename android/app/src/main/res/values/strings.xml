    <string name="settings_feature_video_desc">Videos in the chat: the model watches their frames and hears their sound.</string>
    <string name="settings_feature_audio">Audio</string>
    <string name="settings_feature_audio_desc">Voice messages and audio files. Off: the audio encoder is not loaded, which saves memory.</string>
    <string name="settings_feature_draft">Speculative decoding</string>
    <string name="settings_feature_draft_desc_mtp">The model\'s MTP layer drafts the next word and the model checks two at once: faster answers, the same text. Off: one word at a time.</string>
    <string name="settings_feature_draft_desc_drafter">Gemma\'s drafter guesses the next words and the model checks them at once: faster answers, the same text. Off: one word at a time, and the drafter\'s memory saved.</string>
    <string name="settings_sampling_recommended">Recommended for %1$s in this mode: temperature %2$.2f, top-p %3$.2f, top-k %4$d, presence penalty %5$.1f.</string>
